<!DOCTYPE html>
<html lang="{{ language.code }}" dir="{{ theme.is_rtl ? 'rtl' : 'ltr' }}">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  {{ theme.settings.set('placeholder', 'images/placeholder.svg') }}
  <script defer data-cfasync="false" src="{{ 'zod-menu.js'|asset }}"></script>
  {% block head_scripts %}{% endblock %}
  <script data-cfasync="false">
    {# Boolean settings must stay booleans; the string 'false' is truthy in JavaScript. #}
    window.header_is_sticky = {{ theme.settings.get('header_is_sticky', true) | json_encode }};
    window.imageZoom = "{{ theme.settings.get('imageZoom') }}";
    window.can_access_wallet = {{ user.can_access_wallet | json_encode }};
    window.enable_more_menu = {{ theme.settings.get('enable_more_menu', true) | json_encode }};
    window.enable_add_product_toast = {{ theme.settings.get('enable_add_product_toast', true) | json_encode }};
    window.notify_when_available_in_card = {{ theme.settings.get('notify_when_available_in_card', true) | json_encode }};

    window.zodSettings = {
      stickyHeader: {{ theme.settings.get('header_is_sticky', true) | json_encode }},
      mobileBottomNav: {{ theme.settings.get('show_mobile_bottom_nav', true) | json_encode }},
      notifyWhenAvailable: {{ theme.settings.get('notify_when_available_in_card', true) | json_encode }},
      showTags: {{ theme.settings.get('show_tags', true) | json_encode }},
      i18n: {
        cartAdded: {{ trans('zod.cart.added') | json_encode | raw }},
        cartUpdated: {{ trans('zod.cart.updated') | json_encode | raw }},
        cartRemoved: {{ trans('zod.cart.removed') | json_encode | raw }}
      }
    };
  </script>
  {% hook 'head:start' %}
  {% hook head %}
  {% block styles %}{% endblock %}
  <link rel="stylesheet" href="{{ 'app.css' | asset }}">
  <link rel="stylesheet" href="{{ 'refinement.css' | asset }}">
  <link rel="stylesheet" href="{{ theme.font.path|cdn }}">
  <link rel="stylesheet" href="{{ 'fonts/sallaicons.css'|cdn }}">
  <style>
    :root {
      --font-main: '{{ theme.font.name }}';
      --color-primary: {{ theme.color.primary }};
      --color-primary-dark: {{ theme.color.darker(0.14) }};
      --color-primary-light: {{ theme.color.lighter(0.22) }};
      --color-primary-reverse: {{ theme.color.reverse_text }};
      --zod-ink: #17191c;
      --zod-muted: #667085;
      --zod-canvas: #f6f7f8;
      --zod-line: #e7e9ec;
      --zod-success: #147a4b;
      --zod-danger: #b4232a;
      --zod-radius: 16px;
      --zod-search-question: '{{ trans('zod.header.search_question') }}';
    }
  </style>
  {% hook 'head:end' %}
</head>
<body id="app" class="zod-commerce overflow-x-hidden {% hook 'body:classes' %} {{ is_page('product.single') and theme.settings.get('sticky_add_to_cart') ? 'is-sticky-product-bar' : '' }} {{ theme.settings.get('show_mobile_bottom_nav', true) ? 'has-mobile-bottom-nav' : '' }} {{ is_page('product.single') ? 'product-single' : '' }} {{ is_page('cart') ? 'cart-page' : '' }}">
<a class="zod-skip-link" href="#main-content">{{ trans('zod.common.skip_content') }}</a>
<noscript><div class="zod-noscript">{{ trans('zod.common.javascript_required') }}</div></noscript>
<div class="app-inner min-h-screen flex flex-col">
  {% hook 'body:start' %}
  {% component 'header.header' %}
  <main id="main-content" role="main" tabindex="-1" class="flex-1">
    {% block content %}{% endblock %}
  </main>
  {% component 'footer.footer' %}
</div>
{% hook 'body:end' %}
{# Required Twilight toast, with its event controller. Other notices stay with ZOD. #}
{% if theme.settings.get('enable_add_product_toast', true) %}
<salla-add-product-toast data-testid="store-add-product-toast" data-cart-url="{{ link('cart') }}" data-label-added="{{ trans('zod.cart.added') }}" data-label-cart="{{ trans('zod.cart.view_cart') }}" data-label-continue="{{ trans('zod.cart.continue_shopping') }}" data-label-close="{{ trans('zod.header.close') }}" data-label-quantity="{{ trans('zod.cart.quantity') }}"></salla-add-product-toast>
<script defer src="{{ 'add-product-toast.js' | asset }}"></script>
{% endif %}
<script defer crossorigin="anonymous" src="{{ 'app.js' | asset }}"></script>
<script defer crossorigin="anonymous" src="{{ 'legacy-product-card.js' | asset }}"></script>
{% if theme.settings.get('show_shipping_goal', true) %}{% include 'components.shipping-goal' %}{% endif %}
<salla-offer-modal data-testid="store-offer-modal"></salla-offer-modal>
<salla-search data-testid="store-search-modal"></salla-search>
<salla-login-modal data-testid="store-login-modal"></salla-login-modal>
{% if store.scope %}<salla-scopes data-testid="store-scopes" selection="{{ store.scope.display_as == 'popup' ? 'mandatory' : 'optional' }}"></salla-scopes>{% endif %}
{% if theme.settings.get('show_mobile_bottom_nav', true) %}
<nav class="zod-mobile-dock lg:hidden" aria-label="{{ trans('zod.header.menu') }}">
  <a href="{{ link('/') }}" {% if is_page('index') %}aria-current="page"{% endif %}><i class="sicon-home"></i><span>{{ trans('zod.mobile.home') }}</span></a>
  <button type="button" onclick="window.zodMenu?.open(this)"><i class="sicon-layout-grid"></i><span>{{ trans('zod.mobile.categories') }}</span></button>
  <button type="button" onclick="salla.event.dispatch('search::open')"><span class="zod-dock-search"><i class="sicon-search"></i></span><small>{{ trans('zod.mobile.search') }}</small></button>
  <a href="{{ link('cart') }}" {% if is_page('cart') %}aria-current="page"{% endif %}><i class="sicon-shopping-bag"></i><span>{{ trans('zod.mobile.cart') }}</span></a>
  <a href="{{ link('profile') }}" class="zod-dock-account" aria-label="{{ trans('zod.mobile.account') }}">
    <svg class="zod-dock-account-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="3.25"></circle><path d="M5.75 19c.7-3.25 3-5 6.25-5s5.55 1.75 6.25 5"></path></svg>
    <span>{{ trans('zod.mobile.account') }}</span>
  </a>
</nav>
{% endif %}
{% block scripts %}{% endblock %}
</body>
</html>
