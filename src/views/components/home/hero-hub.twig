{% set category_urls = {} %}
{% for slot in ['exhaust', 'intercom', 'insect'] %}
  {% set selection = component[slot ~ '_category']|default([]) %}
  {% set category = selection.url is defined or selection.id is defined ? selection : (selection is iterable ? selection|first : null) %}
  {% set category_url = category.url|default(component[slot ~ '_url']|default(null)) %}
  {% set category_urls = category_urls|merge({(slot): category_url}) %}
{% endfor %}
{% set configured_campaigns = [
 {key:'intercom', mobile:component.hero_intercom_mobile_image|default(component.hero_intercom_image|default(null)), alt:trans('zod.hero_art.intercom'), image:component.hero_intercom_image|default(null), url:category_urls.intercom},
 {key:'ventilation', mobile:component.hero_ventilation_mobile_image|default(component.hero_ventilation_image|default(null)), alt:trans('zod.hero_art.ventilation'), image:component.hero_ventilation_image|default(null), url:category_urls.exhaust},
 {key:'insects', mobile:component.hero_insects_mobile_image|default(component.hero_insects_image|default(null)), alt:trans('zod.hero_art.insects'), image:component.hero_insects_image|default(null), url:category_urls.insect}
] %}
{% set campaigns = [] %}
{% for campaign in configured_campaigns %}{% if campaign.image or campaign.mobile %}{% set campaigns = campaigns|merge([campaign]) %}{% endif %}{% endfor %}
{% if campaigns|length or component.show_shipping or (component.show_mada and component.mada_terms) %}
<section class="zod-campaign container" data-zod-campaign data-autoplay="{{ component.campaign_autoplay is defined and not component.campaign_autoplay ? 'false' : 'true' }}" aria-label="{{ trans('zod.campaign.eyebrow') }}" aria-roledescription="carousel">
 {% if campaigns|length %}
 <div class="zod-campaign__viewport" data-campaign-viewport tabindex="0" aria-label="{{ trans('zod.hero_products.navigation') }}">
 {% for campaign in campaigns %}
  <article class="zod-campaign__slide" data-campaign-slide role="group" aria-roledescription="slide" aria-label="{{ trans('zod.hero_products.' ~ campaign.key ~ '_cta') }}" {% if not loop.first %}hidden{% endif %}>
   <picture><source media="(max-width:767px)" srcset="{{ campaign.mobile }}"><img class="zod-campaign__art" src="{{ campaign.image|default(campaign.mobile) }}" width="1440" height="480" alt="{{ component['hero_' ~ campaign.key ~ '_alt']|default(campaign.alt) }}" draggable="false" decoding="async" {{ loop.first ? 'loading="eager" fetchpriority="high"' : 'loading="lazy"' }}></picture>
   <div class="zod-campaign__copy" lang="ar" dir="rtl">
    <h2>{{ component['hero_' ~ campaign.key ~ '_heading']|default(trans('zod.hero_copy.' ~ campaign.key ~ '_heading')) }}</h2>
    <p>{{ component['hero_' ~ campaign.key ~ '_text']|default(trans('zod.hero_copy.' ~ campaign.key ~ '_text')) }}</p>
    {% if campaign.url %}<a class="zod-campaign__cta" data-zod-category-link href="{{ campaign.url }}">{{ component['hero_' ~ campaign.key ~ '_button']|default(trans('zod.hero_copy.' ~ campaign.key ~ '_button')) }}<span aria-hidden="true">←</span></a>{% endif %}
   </div>
  </article>
 {% endfor %}
 </div>
 {% if campaigns|length > 1 and (component.show_campaign_progress is not defined or component.show_campaign_progress is null or component.show_campaign_progress) %}
 <div class="zod-campaign__progress"><input type="range" min="1" max="{{ campaigns|length }}" step="1" value="1" data-campaign-progress aria-label="{{ trans('zod.hero_products.navigation') }}" aria-valuetext="{{ (campaigns|first).alt }}"></div>
 {% endif %}
 {% endif %}
 <div class="zod-offer-tiles">
  {% if component.show_shipping %}{% include 'components.shipping-progress' with {shipping_component:component} %}{% endif %}
  {% if component.show_mada and component.mada_terms %}<article class="zod-offer-tile is-mada"><span class="zod-offer-tile__number" aria-hidden="true">5<span>%</span></span><div><strong>{{ trans('zod.campaign.mada') }}</strong><p>{{ trans('zod.campaign.mada_text') }}</p><a href="{{ component.mada_terms }}">{{ trans('zod.campaign.terms') }}</a></div></article>{% endif %}
 </div>
</section>

{% endif %}
