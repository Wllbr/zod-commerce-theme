<section data-testid="store-home-fixed-products" class="zod-section">
  <div class="container">
    {% if title %}<div class="zod-section-head"><h2>{{ title }}</h2>{% if display_all_url %}<a class="zod-text-link" href="{{ display_all_url }}">{{ trans('zod.home.view_all') }} <i class="sicon-arrow-left rtl:rotate-180"></i></a>{% endif %}</div>{% endif %}
    <salla-products-slider autoplay data-testid="store-home-fixed-products-list" source="{{ products.source }}" limit="{{ limit }}" source-value="{{ products.source_value|json_encode }}" slider-id="zod-fixed-products-{{ position }}"></salla-products-slider>
  </div>
</section>
