<section data-testid="store-home-featured-products" class="zod-section"><div class="container">{% if main_product %}<div class="zod-featured-native"><div class="zod-featured-native__main"><custom-salla-product-card product="{{ main_product.product }}"></custom-salla-product-card></div><div class="zod-featured-native__grid">{% for section in items|slice(0,1) %}{% for product in section.products|slice(0,6) %}<custom-salla-product-card product="{{ product }}"></custom-salla-product-card>{% endfor %}{% endfor %}</div></div>{% else %}<div class="zod-featured-native__grid zod-featured-native__grid--full">{% for section in items|slice(0,1) %}{% for product in section.products|slice(0,8) %}<custom-salla-product-card product="{{ product }}"></custom-salla-product-card>{% endfor %}{% endfor %}</div>{% endif %}</div></section>
