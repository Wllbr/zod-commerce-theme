{% if image.url %}<section data-testid="store-home-fixed-banner" class="zod-section"><div class="container"><a class="zod-native-banner" href="{{ url }}"><picture>{% if image.small_url %}<source media="(max-width:767px)" srcset="{{ image.small_url }}">{% endif %}<img src="{{ image.url }}" alt="{{ image.alt|default(store.name) }}" loading="lazy"></picture></a></div></section>{% endif %}
