{% if component.categories|length %}
<section class="zod-section zod-category-section">
  <div class="container">
    <div class="zod-section-head">
      <div><h2>{{ component.title|default(trans('zod.home.shop_categories')) }}</h2>{% if component.subtitle %}<p>{{ component.subtitle }}</p>{% endif %}</div>
      {% if component.show_all %}<a href="{{ link('categories') }}" class="zod-text-link">{{ trans('zod.home.view_all') }} <i class="sicon-arrow-left rtl:rotate-180"></i></a>{% endif %}
    </div>
    <div class="zod-category-scroller">
      {% for category in component.categories %}
        <a class="zod-category-card" href="{{ category.url }}">
          <span class="zod-category-card__media"><img src="{{ category.image|default('images/placeholder.svg'|asset) }}" alt="{{ category.name }}" loading="lazy"></span>
          <span class="zod-category-card__name">{{ category.name }}</span>
          {% if category.products_count %}<small>{{ category.products_count }} {{ trans('zod.catalog.products')|lower }}</small>{% endif %}
        </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
