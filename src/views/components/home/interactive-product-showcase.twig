{% set featured = component.products|first %}
{% if featured %}
  {% set custom_title = component.title is iterable ? component.title[language.code]|default(component.title|first) : component.title %}
  {% set text = component.text is iterable ? component.text[language.code]|default(component.text|first) : component.text %}
  {% set view_button = component.view_button is iterable ? component.view_button[language.code]|default(component.view_button|first) : component.view_button %}
  {% set has_valid_sale = featured.is_on_sale and featured.sale_price and featured.sale_price != '-' %}
  {% set showcase_price = has_valid_sale ? featured.sale_price : featured.price %}
  {% set has_display_price = showcase_price and showcase_price != '-' %}
  <section class="zod-section zod-interactive-showcase-section" data-zod-interactive-showcase data-product-id="{{ featured.id }}">
    <div class="container">
      <article class="zod-interactive-showcase">
        <div class="zod-interactive-showcase__media">
          {% set poster = component.media|default(featured.image.url|default(featured.thumbnail)) %}
          {% if component.video_url %}
            <video
              class="zod-interactive-showcase__video"
              muted
              loop
              playsinline
              preload="none"
              {% if poster %}poster="{{ poster }}"{% endif %}
              aria-label="{{ custom_title|default(featured.name) }}"
            >
              <source src="{{ component.video_url }}" type="video/mp4">
            </video>
          {% elseif poster %}
            <img src="{{ poster }}" alt="{{ custom_title|default(featured.name) }}" loading="lazy">
          {% endif %}
          <div class="zod-interactive-showcase__media-shade"></div>
        </div>

        <div class="zod-interactive-showcase__content">
          <h2>{{ custom_title|default(featured.name) }}</h2>
          {% if text %}<p class="zod-interactive-showcase__lead">{{ text }}</p>{% endif %}

          <div class="zod-interactive-showcase__price" data-zod-live-price data-product-id="{{ featured.id }}" data-price-ready="{{ has_display_price ? '1' : '0' }}" {{ not has_display_price ? 'hidden' : '' }}>
            <strong data-zod-price-current>{% if has_display_price %}{{ showcase_price|money }}{% endif %}</strong>
            <del data-zod-price-regular {{ not has_valid_sale ? 'hidden' : '' }}>{% if has_valid_sale %}{{ featured.regular_price|money }}{% endif %}</del>
          </div>

          {% if component.show_countdown and component.countdown_date %}
            <div class="zod-interactive-showcase__countdown">
              <span><i class="sicon-clock"></i>{{ trans('zod.showcase.offer_ends') }}</span>
              <salla-count-down date="{{ component.countdown_date }}" color="primary" size="sm" labeled></salla-count-down>
            </div>
          {% endif %}

          {% if component.features|length %}
            <div class="zod-interactive-features" role="tablist" aria-label="{{ trans('zod.showcase.features') }}">
              <div class="zod-interactive-features__icons">
                {% for feature in component.features %}
                  {% set feature_title = feature.title is iterable ? feature.title[language.code]|default(feature.title|first) : feature.title %}
                  {% set icon_choice = feature.icon is iterable ? feature.icon|first : feature.icon %}
                  {% set icon_value = icon_choice.value|default(icon_choice) %}
                  <button
                    type="button"
                    class="zod-feature-icon {{ loop.first ? 'is-active' : '' }}"
                    id="zod-feature-tab-{{ position|default(0) }}-{{ loop.index0 }}"
                    aria-controls="zod-feature-panel-{{ position|default(0) }}-{{ loop.index0 }}"
                    data-icon="{{ icon_value }}"
                    data-zod-feature-trigger="{{ loop.index0 }}"
                    role="tab"
                    aria-selected="{{ loop.first ? 'true' : 'false' }}"
                    aria-label="{{ feature_title }}"
                  >
                    {% if icon_value == 'screen' %}
                      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
                    {% elseif icon_value == 'wifi' %}
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5a10 10 0 0 1 14 0M8.5 16a5 5 0 0 1 7 0M12 20h.01M2 9a14 14 0 0 1 20 0"/></svg>
                    {% elseif icon_value == 'door' %}
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 21h14M7 21V4a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v17"/><path d="M14 12h.01"/></svg>
                    {% elseif icon_value == 'power' %}
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/></svg>
                    {% elseif icon_value == 'camera' %}
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h3l2-3h6l2 3h3a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2Z"/><circle cx="12" cy="13" r="4"/></svg>
                    {% elseif icon_value == 'shield' %}
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4 6v5c0 5 3.3 8.5 8 10 4.7-1.5 8-5 8-10V6l-8-3Z"/><path d="m9 12 2 2 4-4"/></svg>
                    {% elseif icon_value == 'delivery' %}
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h11v10H3zM14 9h4l3 3v4h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg>
                    {% elseif icon_value == 'fan' %}
                      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="2"/><path d="M12 10c-6-8-11 1-3 3M14 12c8-6-1-11-3-3M12 14c6 8 11-1 3-3M10 12c-8 6 1 11 3 3"/></svg>
                    {% elseif icon_value == 'airflow' %}
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 8h12a3 3 0 1 0-3-3M3 12h16a3 3 0 1 1-3 3M3 16h6a3 3 0 1 1-3 3"/></svg>
                    {% elseif icon_value == 'plug' %}
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3v5M16 3v5M6 8h12v4a6 6 0 0 1-12 0V8ZM12 18v4"/></svg>
                    {% elseif icon_value == 'battery' %}
                      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="6" width="18" height="12" rx="2"/><path d="M22 10v4M6 10v4M10 10v4M14 10v4"/></svg>
                    {% elseif icon_value == 'charger' %}
                      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="5" width="14" height="14" rx="3"/><path d="M9 2v3M15 2v3M12 19v3M13 8l-4 5h4l-2 3"/></svg>
                    {% elseif icon_value == 'light' %}
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18v3h6v-3M8 14a6 6 0 1 1 8 0l-1 3H9l-1-3ZM12 1v1M2 9H1M23 9h-1"/></svg>
                    {% elseif icon_value == 'sensor' %}
                      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="2"/><path d="M7 7a7 7 0 0 0 0 10M17 7a7 7 0 0 1 0 10M4 4a11 11 0 0 0 0 16M20 4a11 11 0 0 1 0 16"/></svg>
                    {% elseif icon_value == 'speaker' %}
                      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="2" width="14" height="20" rx="2"/><circle cx="12" cy="15" r="4"/><circle cx="12" cy="6" r="1"/></svg>
                    {% elseif icon_value == 'temperature' %}
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 14V5a3 3 0 0 1 6 0v9a5 5 0 1 1-6 0ZM12 7v10M18 6h3M18 10h3"/></svg>
                    {% elseif icon_value == 'ruler' %}
                      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="7" width="18" height="10" rx="1"/><path d="M7 7v5M11 7v3M15 7v5M19 7v3"/></svg>
                    {% elseif icon_value == 'water' %}
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C9 7 5 11 5 15a7 7 0 0 0 14 0c0-4-4-8-7-13Z"/><path d="m9 15 2 2 4-4"/></svg>
                    {% elseif icon_value == 'tools' %}
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3a6 6 0 0 0-7 8l-4 7a2 2 0 0 0 3 3l7-7a6 6 0 0 0 8-7l-4 4-4-4 1-4Z"/></svg>
                    {% elseif icon_value == 'sun' %}
                      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 1v3M12 20v3M1 12h3M20 12h3M4 4l2 2M18 18l2 2M4 20l2-2M18 6l2-2"/></svg>
                    {% elseif icon_value == 'remote' %}
                      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="3" width="10" height="19" rx="3"/><circle cx="12" cy="9" r="2"/><path d="M10 15h4M10 18h4M9 1h6"/></svg>
                    {% elseif icon_value == 'insect' %}
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6 7 3M15 6l2-3M8 10H4M16 10h4M8 15H4M16 15h4M8 19l-3 2M16 19l3 2"/><rect x="8" y="6" width="8" height="15" rx="4"/><path d="M8 12h8M12 12v9"/></svg>
                    {% elseif icon_value == 'quiet' %}
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9v6h4l5 4V5L7 9H3ZM16 9l5 6M21 9l-5 6"/></svg>
                    {% else %}
                      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                    {% endif %}
                  </button>
                {% endfor %}
              </div>

              <div class="zod-interactive-features__copy">
                {% for feature in component.features %}
                  {% set feature_title = feature.title is iterable ? feature.title[language.code]|default(feature.title|first) : feature.title %}
                  {% set feature_text = feature.text is iterable ? feature.text[language.code]|default(feature.text|first) : feature.text %}
                  <div id="zod-feature-panel-{{ position|default(0) }}-{{ loop.index0 }}" aria-labelledby="zod-feature-tab-{{ position|default(0) }}-{{ loop.index0 }}" class="zod-feature-panel {{ loop.first ? 'is-active' : '' }}" data-zod-feature-panel="{{ loop.index0 }}" role="tabpanel">
                    {% if feature_title %}<strong>{{ feature_title }}</strong>{% endif %}
                    {% if feature_text %}<p>{{ feature_text }}</p>{% endif %}
                  </div>
                {% endfor %}
              </div>
            </div>
          {% endif %}

          <div class="zod-interactive-showcase__actions">
            {% if featured.id %}
              <salla-add-product-button fill="solid" product-id="{{ featured.id }}" product-status="{{ featured.status }}" product-type="{{ featured.type }}">{{ featured.add_to_cart_label|default(trans('pages.cart.add_to_cart')) }}</salla-add-product-button>
            {% endif %}
            {% if view_button %}<a class="zod-btn zod-btn--ghost" href="{{ featured.url }}">{{ view_button }} <i class="sicon-arrow-left rtl:rotate-180"></i></a>{% endif %}
          </div>
        </div>
      </article>
    </div>
  </section>
{% endif %}
