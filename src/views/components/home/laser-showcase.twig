{% if component.items|length %}
  {% set section_title = component.title is iterable ? component.title[language.code]|default(component.title|first) : component.title %}
  {% set section_subtitle = component.subtitle is iterable ? component.subtitle[language.code]|default(component.subtitle|first) : component.subtitle %}
  <section class="zod-section zod-laser-showcase" data-zod-laser-showcase>
    <div class="container">
      <header class="zod-laser-showcase__head">
        <span class="zod-laser-showcase__beam" aria-hidden="true"></span>
        <div>
          <small>{{ trans('zod.laser.eyebrow') }}</small>
          <h2>{{ section_title|default(trans('zod.laser.title')) }}</h2>
          <p>{{ section_subtitle|default(trans('zod.laser.subtitle')) }}</p>
        </div>
      </header>

      <div class="zod-laser-stage">
        {% for item in component.items %}
          {% set product = item.products|first %}
          {% if product %}
            {% set item_eyebrow = item.eyebrow is iterable ? item.eyebrow[language.code]|default(item.eyebrow|first) : item.eyebrow %}
            {% set item_text = item.text is iterable ? item.text[language.code]|default(item.text|first) : item.text %}
            {% set feature_one = item.feature_one is iterable ? item.feature_one[language.code]|default(item.feature_one|first) : item.feature_one %}
            {% set feature_two = item.feature_two is iterable ? item.feature_two[language.code]|default(item.feature_two|first) : item.feature_two %}
            {% set feature_three = item.feature_three is iterable ? item.feature_three[language.code]|default(item.feature_three|first) : item.feature_three %}
            {% set poster = item.poster|default(product.image.url|default(product.thumbnail)) %}
            {% set video_url = item.video_url.url|default(item.video_url)|default(null) %}
            {% set product_url = product.url|default(link('product/' ~ product.id)) %}
            {% set sale_price = product.is_on_sale and product.sale_price and product.sale_price > 0 ? product.sale_price : null %}
            <article id="zod-laser-panel-{{ loop.index0 }}" class="zod-laser-panel {{ loop.first ? 'is-active' : '' }}" data-zod-laser-panel="{{ loop.index0 }}" {% if not loop.first %}hidden{% endif %}>
              <div class="zod-laser-panel__media">
                {% if video_url %}
                  <video class="zod-laser-panel__video" muted loop playsinline preload="none" {% if poster %}poster="{{ poster }}"{% endif %} data-zod-laser-video data-video-src="{{ video_url }}" aria-label="{{ product.name }}"></video>
                {% elseif poster %}
                  <img src="{{ poster }}" alt="{{ product.name }}" loading="lazy">
                {% endif %}
                <span class="zod-laser-panel__glow" aria-hidden="true"></span>
                {% if video_url %}<span class="zod-laser-panel__live"><i></i>{{ trans('zod.laser.motion_preview') }}</span>{% endif %}
              </div>
              <div class="zod-laser-panel__content">
                <small class="zod-laser-panel__eyebrow">{{ item_eyebrow|default(trans('zod.laser.featured')) }}</small>
                <h3>{{ product.name }}</h3>
                {% if item_text %}<p>{{ item_text }}</p>{% endif %}
                {% if feature_one or feature_two or feature_three %}
                  <ul class="zod-laser-panel__features" aria-label="{{ trans('zod.laser.features') }}">
                    {% if feature_one %}<li><i class="sicon-check"></i>{{ feature_one }}</li>{% endif %}
                    {% if feature_two %}<li><i class="sicon-check"></i>{{ feature_two }}</li>{% endif %}
                    {% if feature_three %}<li><i class="sicon-check"></i>{{ feature_three }}</li>{% endif %}
                  </ul>
                {% endif %}
                <div class="zod-laser-panel__buy">
                  <div class="zod-laser-panel__price">
                    <small>{{ trans('zod.laser.price') }}</small>
                    <strong>{{ (sale_price ?: product.price)|money }}</strong>
                    {% if sale_price %}<del>{{ product.regular_price|money }}</del>{% endif %}
                  </div>
                  <span class="zod-laser-panel__stock {{ product.status == 'sale' ? 'is-available' : '' }}"><i></i>{{ product.status == 'sale' ? trans('zod.laser.available') : trans('pages.products.out_of_stock') }}</span>
                </div>
                <div class="zod-laser-panel__actions">
                  <a href="{{ product_url }}" class="zod-laser-panel__view">{{ trans('zod.laser.view_product') }} <i class="sicon-arrow-left rtl:rotate-180"></i></a>
                  <salla-add-product-button fill="solid" product-id="{{ product.id }}" product-status="{{ product.status }}" product-type="{{ product.type }}">{{ product.add_to_cart_label|default(trans('pages.cart.add_to_cart')) }}</salla-add-product-button>
                </div>
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>

      <div class="zod-laser-selector" role="tablist" aria-label="{{ trans('zod.laser.choose_product') }}">
        {% for item in component.items %}
          {% set product = item.products|first %}
          {% if product %}
            {% set thumb = item.poster|default(product.image.url|default(product.thumbnail)) %}
            <button type="button" class="zod-laser-selector__item {{ loop.first ? 'is-active' : '' }}" data-zod-laser-trigger="{{ loop.index0 }}" role="tab" aria-selected="{{ loop.first ? 'true' : 'false' }}" aria-controls="zod-laser-panel-{{ loop.index0 }}">
              {% if thumb %}<img src="{{ thumb }}" alt="" loading="lazy">{% endif %}
              <span><strong>{{ product.name }}</strong><small>{{ product.price|money }}</small></span>
              <i class="sicon-play" aria-hidden="true"></i>
            </button>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}
