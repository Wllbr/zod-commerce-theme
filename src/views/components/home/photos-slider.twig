{% if items|length %}<section data-testid="store-home-photos-slider" class="zod-section"><div class="container"><salla-slider type="carousel" class="zod-photo-slider" centered auto-play pagination id="zod-photos-{{ position }}"><div slot="items">{% for item in items %}<a class="swiper-slide" href="{{ item.url }}"><img src="{{ item.image.url }}" alt="{{ item.image.alt|default(store.name) }}" loading="lazy"></a>{% endfor %}</div></salla-slider></div></section>{% endif %}
