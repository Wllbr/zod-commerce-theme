{% if component.items|length %}
<section class="zod-trust-strip"><div class="container"><div class="zod-trust-grid">
{% for item in component.items %}<div class="zod-trust-item"><span class="zod-trust-icon"><i class="{{ item.icon|default('sicon-check-circle') }}"></i></span><span><strong>{{ item.title }}</strong>{% if item.text %}<small>{{ item.text }}</small>{% endif %}</span></div>{% endfor %}
</div></div></section>
{% endif %}
