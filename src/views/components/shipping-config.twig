data-shipping-enabled="{{ theme.settings.get('shipping_campaign_enabled', true) ? 'true' : 'false' }}"
{% set shipping_value = shipping_component is defined and shipping_component.shipping_goal_target is defined ? shipping_component.shipping_goal_target : theme.settings.get('shipping_goal_target', '350') %}
data-shipping-target="{{ shipping_value|e('html_attr') }}"
{% set shipping_value = shipping_component is defined and shipping_component.shipping_after_discount is defined ? shipping_component.shipping_after_discount : theme.settings.get('shipping_after_discount', true) %}
data-shipping-after-discount="{{ shipping_value ? 'true' : 'false' }}"
{% set shipping_value = shipping_component is defined and shipping_component.shipping_notify is defined ? shipping_component.shipping_notify : theme.settings.get('shipping_notify', true) %}
data-shipping-notify="{{ shipping_value ? 'true' : 'false' }}"
{% set shipping_value = shipping_component is defined and shipping_component.shipping_initial_text is defined ? shipping_component.shipping_initial_text : theme.settings.get('shipping_initial_text', '') %}
data-shipping-initial="{{ shipping_value|e('html_attr') }}"
{% set shipping_value = shipping_component is defined and shipping_component.shipping_remaining_text is defined ? shipping_component.shipping_remaining_text : theme.settings.get('shipping_remaining_text', '') %}
data-shipping-remaining="{{ shipping_value|e('html_attr') }}"
{% set shipping_value = shipping_component is defined and shipping_component.shipping_success_text is defined ? shipping_component.shipping_success_text : theme.settings.get('shipping_success_text', '') %}
data-shipping-success="{{ shipping_value|e('html_attr') }}"
{% set shipping_value = shipping_component is defined and shipping_component.shipping_terms_text is defined ? shipping_component.shipping_terms_text : theme.settings.get('shipping_terms_text', '') %}
data-shipping-terms-copy="{{ shipping_value|e('html_attr') }}"
{% set shipping_value = shipping_component is defined and shipping_component.shipping_icon is defined ? shipping_component.shipping_icon : theme.settings.get('shipping_icon', '🚚') %}
data-shipping-icon="{{ shipping_value|e('html_attr') }}"
{% set shipping_value = shipping_component is defined and shipping_component.shipping_complete_icon is defined ? shipping_component.shipping_complete_icon : theme.settings.get('shipping_complete_icon', '🎉') %}
data-shipping-complete-icon="{{ shipping_value|e('html_attr') }}"
