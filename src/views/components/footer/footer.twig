<footer data-testid="store-footer" class="zod-footer zod-footer--light">
  <div class="zod-footer-main">
    <div class="container">
      <div class="zod-footer-social-row">
        <salla-social data-testid="store-footer-social"></salla-social>
      </div>

      <div class="zod-footer-divider"></div>

      <div class="zod-footer-grid">
        <div class="zod-footer-brand">
          <a href="{{ link('/') }}" class="zod-footer-logo"><img src="{{ store.logo|cdn(220) }}" alt="{{ store.name }}"></a>
          {% if store.slogan %}<strong class="zod-footer-slogan">{{ store.slogan }}</strong>{% endif %}
          {% if store.description %}<div class="zod-footer-description">{{ store.description|raw }}</div>{% endif %}
        </div>

        <details class="zod-footer-column zod-footer-disclosure" data-footer-disclosure open>
          <summary><span>{{ trans('blocks.footer.pages_links') }}</span><i class="sicon-keyboard_arrow_down"></i></summary>
          <div class="zod-footer-disclosure__body">
            <salla-menu data-testid="store-footer-menu" source="footer" with-cookie-preferences></salla-menu>
          </div>
        </details>

        <details class="zod-footer-column zod-footer-disclosure" data-footer-disclosure open>
          <summary><span>{{ trans('zod.footer.contact') }}</span><i class="sicon-keyboard_arrow_down"></i></summary>
          <div class="zod-footer-disclosure__body">
            <salla-contacts data-testid="store-footer-contacts"></salla-contacts>
          </div>
        </details>

        <div class="zod-footer-column zod-footer-business">
          <h3>{{ trans('zod.footer.store_info') }}</h3>
          <salla-trust-badges data-testid="store-footer-trust-badges"></salla-trust-badges>
          {% if store.settings.tax.number %}
            <div class="zod-footer-tax">
              <span>{{ trans('common.elements.tax_number') }}</span>
              <b>{{ store.settings.tax.number }}</b>
              {% if store.settings.tax.certificate %}
                <a class="load-img-onclick" data-modal-id="modal-zod-tax" href="#/">{{ trans('zod.footer.view_certificate') }}</a>
              {% endif %}
            </div>
            {% if store.settings.tax.certificate %}
              <salla-modal sub-title-first sub-title="{{ trans('common.elements.tax_number') }}" modal-title="{{ store.settings.tax.number }}" id="modal-zod-tax">
                <div class="flex justify-center max-w-full"><img class="w-full" loading="lazy" data-src="{{ store.settings.tax.certificate }}" alt="{{ store.settings.tax.number }}"></div>
              </salla-modal>
            {% endif %}
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  <div class="zod-footer-bottom">
    <div class="container zod-footer-bottom__inner">
      <span class="zod-footer-copyright">{% hook copyright %}</span>
      <salla-payments data-testid="store-footer-payments"></salla-payments>
    </div>
  </div>
</footer>
