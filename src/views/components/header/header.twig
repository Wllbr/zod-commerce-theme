{% set zod_brand_logo = store.logo ? store.logo|cdn(260) : 'images/zod-logo.png'|asset %}
<header data-testid="store-header" class="zod-header" data-sticky="{{ theme.settings.get('header_is_sticky', true) ? '1' : '0' }}">
  {# Salla Dashboard advertisement bar remains the source of truth. #}
  <salla-advertisement data-testid="store-header-advertisement" class="zod-native-advertisement"></salla-advertisement>

  <div class="zod-header-main zod-header-main--compact">
    <div class="container zod-compact-header">
      <div class="zod-header-actions zod-header-actions--physical-left" aria-label="{{ trans('zod.header.account') }}">
        <span class="zod-header-cart-wrap">
          <salla-cart-summary class="zod-native-cart-summary" aria-hidden="true"><i slot="icon" class="sicon-shopping-bag"></i></salla-cart-summary>
          <a data-testid="store-header-cart" class="zod-cart-link" href="{{ link('cart') }}" aria-label="{{ trans('zod.mobile.cart') }}">
            <i class="sicon-shopping-bag"></i>
            <span class="zod-cart-count" data-zod-cart-count hidden>0</span>
          </a>
        </span>
        <salla-user-menu data-testid="store-header-user-menu" avatar-only show-header show-trigger></salla-user-menu>
        <button class="zod-header-icon-button" type="button" aria-label="{{ trans('zod.mobile.search') }}" onclick="window.zodTheme?.openSearch(this)">
          <i class="sicon-search"></i>
        </button>
        {% if store.settings.is_multilingual or store.settings.currencies_enabled %}
          <div class="zod-header-localization">
            <salla-localization-modal id="zod-localization-modal" language="{{ language.code }}" data-testid="store-header-localization"></salla-localization-modal>
            <button type="button" class="zod-localization-trigger" aria-label="{{ trans('zod.mobile.language') }}" onclick="document.getElementById('zod-localization-modal')?.open()">
              <span>{{ language.code|upper }}</span>
            </button>
          </div>
        {% endif %}
      </div>

      <a data-testid="store-header-logo" class="zod-logo zod-logo--centered" href="{{ store.url }}">
        <img fetchpriority="high" loading="eager" src="{{ zod_brand_logo }}" alt="{{ store.name }}">
        {% if is_page('index') %}<h1 class="sr-only">{{ store.name }}</h1>{% else %}<span class="sr-only">{{ store.name }}</span>{% endif %}
      </a>

      <button class="zod-menu-trigger" type="button" aria-label="{{ trans('zod.header.menu') }}" aria-controls="zod-catalog-drawer" aria-expanded="false" onclick="window.zodMenu?.open(this)">
        <span>{{ trans('zod.header.menu') }}</span>
        <i class="sicon-menu"></i>
      </button>
    </div>
  </div>

  {# Hidden menu data source. Categories themselves always come from Salla menus/categories. #}
  <zod-main-menu class="zod-menu-source" aria-hidden="true"></zod-main-menu>

  <div id="zod-catalog-drawer" class="zod-catalog-drawer" aria-hidden="true">
    <div class="zod-catalog-drawer__backdrop" data-zod-menu-close></div>
    <aside class="zod-catalog-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ trans('zod.header.all_categories') }}">
      <div class="zod-catalog-drawer__head">
        <strong>{{ trans('zod.header.all_categories') }}</strong>
        <button type="button" class="zod-overlay-close" aria-label="{{ trans('zod.header.close') }}" onclick="window.zodMenu?.close()"><i class="sicon-cancel"></i></button>
      </div>
      {% if store.scope %}
        <button class="zod-catalog-drawer__scope" type="button" onclick="salla.event.dispatch('scopes::open', {'mode':'default'})">
          <i class="sicon-location"></i><span>{{ store.scope.name }}</span><i class="sicon-keyboard_arrow_down"></i>
        </button>
      {% endif %}
      <div id="zod-mobile-menu-content" class="zod-catalog-drawer__content"></div>
    </aside>
  </div>

  <div id="zod-search-overlay" class="zod-search-overlay" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="zod-search-title">
    <button type="button" class="zod-search-overlay__close" aria-label="{{ trans('zod.header.close') }}" onclick="window.zodTheme?.closeSearch()"><i class="sicon-cancel"></i></button>
    <div class="zod-search-overlay__content">
      <img class="zod-search-overlay__logo" src="{{ zod_brand_logo }}" alt="{{ store.name }}">
      <h2 id="zod-search-title">{{ trans('zod.header.search_question') }}</h2>
      <div class="zod-search-box" data-zod-search-box>
        <salla-search data-testid="store-header-search" inline oval height="58"></salla-search>
      </div>
    </div>
  </div>
</header>
