{% extends "layouts.master" %}
{% block content %}
  {% hook 'index:start' %}
  <div class="zod-home">
    {% if theme.settings.get('homepage_ready_layout', true) %}
      {% include 'components.home.ready-home' %}
    {% else %}
      {% component home %}
    {% endif %}
  </div>
  {% hook 'index:end' %}
{% endblock %}
{% block scripts %}<script defer src="{{ 'home.js'|asset }}"></script>{% endblock %}
