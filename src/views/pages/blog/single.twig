{% extends "layouts.master" %}
{% block content %}
{% set related_articles = related|default(article.related|default([])) %}
<div class="container">
  <nav class="zod-breadcrumb"><salla-breadcrumb></salla-breadcrumb></nav>
  <div class="zod-editorial-layout {{ related_articles|length ? 'has-related' : '' }}">
    <article class="zod-article-page zod-editorial-article">
      <header>
        <span class="zod-eyebrow">{{ trans('zod.blog.eyebrow') }}</span>
        <h1>{{ article.title }}</h1>
        <div class="zod-editorial-meta">
          {% if article.created_at %}<time datetime="{{ article.created_at|date('Y-m-d') }}">{{ article.created_at|date('Y-m-d') }}</time>{% endif %}
          {% if article.author.name %}{% if article.author.url %}<a href="{{ article.author.url }}">{{ article.author.name }}</a>{% else %}<span>{{ article.author.name }}</span>{% endif %}{% endif %}
        </div>
      </header>
      {% if article.has_image and article.image.url %}<img class="zod-article-cover" src="{{ article.image.url }}" alt="{{ article.image.alt|default(article.title) }}" width="1200" height="800" decoding="async">{% endif %}
      {# body is the native Article HTML field, not article.content. #}
      <div class="zod-rich-text zod-article-content">{{ article.body|replace({'&nbsp;': ' '})|raw }}</div>
      {% if article.tags|length %}<nav class="zod-editorial-tags" aria-label="{{ trans('zod.blog.topics') }}">{% for tag in article.tags %}<a href="{{ tag.url }}">{{ tag.name }}</a>{% endfor %}</nav>{% endif %}
      {% if store.settings.blog.allow_likes_and_comments %}
        <section class="zod-editorial-comments" aria-label="{{ trans('zod.blog.comments') }}">
          <h2>{{ trans('zod.blog.comments') }}</h2>
          <salla-comments data-testid="store-blog-comments" item-id="{{ article.key }}" type="blog"></salla-comments>
        </section>
      {% endif %}
    </article>
    {% if related_articles|length %}
      <aside class="zod-editorial-related" aria-labelledby="zod-related-title">
        <h2 id="zod-related-title">{{ trans('zod.blog.related') }}</h2>
        {% hook 'blog:single.items.start' %}
        {% for item in related_articles %}
          <a class="zod-editorial-related-card" href="{{ item.url }}">
            {% if item.has_image and item.image.url %}<img src="{{ item.image.url }}" alt="" width="96" height="96" loading="lazy" decoding="async">{% endif %}
            <span>{% if item.created_at %}<time datetime="{{ item.created_at|date('Y-m-d') }}">{{ item.created_at|date('Y-m-d') }}</time>{% endif %}<strong>{{ item.title }}</strong></span>
          </a>
        {% endfor %}
        {% hook 'blog:single.items.end' %}
      </aside>
    {% endif %}
  </div>
</div>
{% endblock %}
