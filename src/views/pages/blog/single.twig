{% extends "layouts.master" %}
{% block content %}<div class="container"><nav class="zod-breadcrumb"><salla-breadcrumb></salla-breadcrumb></nav><article class="zod-article-page"><header><span class="zod-eyebrow">{{ trans('zod.blog.title') }}</span><h1>{{ article.title }}</h1>{% if article.created_at %}<time>{{ article.created_at|date('Y-m-d') }}</time>{% endif %}</header>{% if article.image %}<img class="zod-article-cover" src="{{ article.image }}" alt="{{ article.title }}">{% endif %}<div class="zod-rich-text zod-article-content">{{ article.content|raw }}</div></article>{% if article.related|length %}<section class="zod-section"><div class="zod-section-head"><h2>{{ trans('zod.blog.related') }}</h2></div><div class="zod-blog-grid">{% for item in article.related %}<a class="zod-guide-card" href="{{ item.url }}"><span class="zod-guide-card__media"><img src="{{ item.image }}" alt="{{ item.title }}"></span><span class="zod-guide-card__body"><strong>{{ item.title }}</strong></span></a>{% endfor %}</div></section>{% endif %}</div>{% endblock %}
