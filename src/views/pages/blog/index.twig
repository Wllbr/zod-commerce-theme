{% extends "layouts.master" %}
{% block content %}<div class="container"><nav class="zod-breadcrumb"><salla-breadcrumb></salla-breadcrumb></nav><section class="zod-blog-page"><header class="zod-page-hero"><span class="zod-eyebrow">ZOD</span><h1>{{ page.title|default(trans('zod.blog.title')) }}</h1><p>{{ trans('zod.blog.subtitle') }}</p></header><div class="zod-blog-grid">{% for article in articles %}<article class="zod-blog-card"><a href="{{ article.url }}" class="zod-blog-card__image"><img src="{{ article.image }}" alt="{{ article.title }}" loading="lazy"></a><div><small>{{ article.created_at|date('Y-m-d') }}</small><h2><a href="{{ article.url }}">{{ article.title }}</a></h2>{% if article.summary %}<p>{{ article.summary|striptags }}</p>{% endif %}<a href="{{ article.url }}" class="zod-text-link">{{ trans('zod.home.learn_more') }} <i class="sicon-arrow-left rtl:rotate-180"></i></a></div></article>{% endfor %}</div></section></div>{% endblock %}
