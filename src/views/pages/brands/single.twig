{% extends "layouts.master" %}
{% block content %}<div class="container"><nav class="zod-breadcrumb"><salla-breadcrumb></salla-breadcrumb></nav><section class="zod-brand-page"><header class="zod-brand-hero">{% if brand.logo %}<div class="zod-brand-hero__logo"><img src="{{ brand.logo }}" alt="{{ brand.name }}"></div>{% endif %}<div><span class="zod-eyebrow">{{ trans('zod.brands.title') }}</span><h1>{{ brand.name }}</h1>{% if brand.description %}<div class="zod-rich-text">{{ brand.description|raw }}</div>{% endif %}</div></header><salla-products-list source="brands" source-value="{{ brand.id }}"></salla-products-list></section></div>{% endblock %}
