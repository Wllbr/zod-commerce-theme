{% extends "layouts.master" %}
{% block content %}
<section class="zod-status-page zod-order-complete-page">
  <div class="container">
    <div class="zod-order-complete-progress" aria-label="{{ trans('zod.cart.progress_label') }}">
      <span class="is-done"><i class="sicon-check"></i><b>{{ trans('zod.cart.step_cart') }}</b></span>
      <em><i></i></em>
      <span class="is-done"><i class="sicon-check"></i><b>{{ trans('zod.cart.step_delivery_payment') }}</b></span>
      <em><i></i></em>
      <span class="is-current"><i class="sicon-check"></i><b>{{ trans('zod.cart.order_complete') }}</b></span>
    </div>
    <div class="zod-status-card zod-order-complete-card">
      <span class="zod-status-icon is-success"><i class="sicon-check"></i></span>
      <p class="zod-order-complete-card__eyebrow">{{ trans('zod.cart.journey_complete') }}</p>
      <h1>{{ page.title }}</h1>
      <p class="zod-order-complete-card__hint">{{ trans('zod.cart.thank_you_hint') }}</p>
      <div class="zod-rich-text">{{ page.content|raw }}</div>
      {% if order %}<div class="zod-order-complete-card__details"><salla-order-details order-id="{{ order.id }}"></salla-order-details></div>{% endif %}
      <a href="{{ link('/') }}" class="zod-btn zod-btn--primary">{{ trans('common.elements.back_home') }}</a>
    </div>
    {% if order %}
      <salla-order-shipments class="block mb-6 md:mb-8 empty:hidden"></salla-order-shipments>
      <salla-next-order-coupon data-testid="store-thankyou-coupon"></salla-next-order-coupon>
      {% if order.is_pickable %}<salla-order-branch data-testid="store-thankyou-branch"></salla-order-branch>{% endif %}
    {% endif %}
  </div>
</section>
{% endblock %}
