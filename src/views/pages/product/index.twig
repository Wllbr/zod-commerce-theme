{% extends "layouts.master" %}
{% block content %}
{% set page_data = page|default({}) %}
{% set current_category = category|default(null) %}
{% set has_filters = filters|default(false) %}
{% set listing_source = page_data.slug|default('latest') %}
{% set listing_value = page_data.id|default(null) %}
{% set sorting = sort_options|default([]) %}
{% set initial_sort = '' %}
{% for sort in sorting %}
  {% if sort.is_selected %}{% set initial_sort = sort.id %}{% endif %}
{% endfor %}
{% if not initial_sort and sorting|length %}{% set initial_sort = (sorting|first).id %}{% endif %}

{% if theme.settings.get('product_index_show_breadcrumbs', true) %}
<div class="container"><nav class="zod-breadcrumb"><salla-breadcrumb></salla-breadcrumb></nav></div>
{% endif %}

<section class="zod-catalog-head"><div class="container">
  <div class="zod-catalog-title-wrap">
    {% if current_category and current_category.image %}<img width="80" height="80" src="{{ current_category.image.url|default(current_category.image) }}" alt="{{ current_category.name }}">{% endif %}
    <div>
      <h1 id="page-main-title">{{ page_data.title|default(trans('zod.catalog.products'))|raw }}</h1>
      {% if search_query|default(null) %}
        <p>“{{ search_query }}”</p>
      {% elseif current_category and current_category.description %}
        <div class="zod-category-description">{{ current_category.description|raw }}</div>
      {% else %}<p class="zod-catalog-intro">{{ trans('zod.catalog.browse_hint') }}</p>
      {% endif %}
    </div>
  </div>

  {% if current_category and current_category.sub_categories|default([])|length %}
    <div class="zod-subcategory-strip">
      <span class="zod-subcategory-label">{{ trans('zod.catalog.subcategories') }}</span>
      <div class="zod-subcategory-scroll">
        {% for sub in current_category.sub_categories %}
          <a href="{{ sub.url }}" class="zod-subcategory-card">
            <span>{% if sub.image %}<img src="{{ sub.image.url|default(sub.image) }}" width="64" height="64" alt="{{ sub.name }}" loading="lazy">{% else %}<i class="sicon-folder"></i>{% endif %}</span>
            <b>{{ sub.name }}</b>
          </a>
        {% endfor %}
      </div>
    </div>
  {% endif %}
</div></section>

<div class="s-blocks-wrapper !mt-0">{% hook 'product.index.before_products_group_with_filter' %}</div>
<section class="zod-catalog-body"><div class="container zod-catalog-layout {{ has_filters ? 'zod-catalog-layout--filters' : 'zod-catalog-layout--full' }}">
  {% if has_filters %}
    <aside class="zod-filter-sidebar" id="zod-filters" aria-label="{{ trans('zod.catalog.filter') }}"><div class="zod-filter-head"><strong>{{ trans('zod.catalog.filter') }}</strong><button type="button" class="lg:hidden" data-filter-close aria-label="{{ trans('zod.header.close') }}"><i class="sicon-cancel"></i></button></div><salla-filters data-testid="store-products-filters" id="filters-menu"></salla-filters><div class="zod-filter-footer"><button type="button" class="zod-btn zod-btn--primary" data-filter-close>{{ trans('zod.catalog.view_results') }}</button></div></aside>
    <div class="zod-filter-backdrop" data-filter-close></div>
  {% endif %}

  <div class="zod-catalog-main">
    <div class="zod-catalog-toolbar">
      <div class="zod-catalog-toolbar__left"><strong>{{ trans('zod.catalog.products') }}</strong><span data-zod-catalog-count data-label="{{ trans('zod.catalog.loaded_products') }}" aria-live="polite" aria-atomic="true"></span></div>
      <div class="zod-catalog-toolbar__actions">
        {% if has_filters %}<button data-testid="store-products-filters-mobile-trigger" type="button" class="zod-filter-trigger lg:hidden" data-filter-open aria-controls="zod-filters" aria-expanded="false"><i class="sicon-filter"></i>{{ trans('zod.catalog.filter') }}</button>{% endif %}
        {% if sorting|length %}<label class="zod-sort"><span>{{ trans('zod.catalog.sort') }}</span><select id="product-filter">{% for sort in sorting %}<option value="{{ sort.id }}" {{ sort.id == initial_sort ? 'selected' : '' }}>{{ sort.name }}</option>{% endfor %}</select></label>{% endif %}
      </div>
    </div>

    <p class="zod-catalog-loading" data-zod-catalog-loading hidden role="status">{{ trans('zod.catalog.loading') }}</p>
    {% hook 'product:index.items.start' %}
    <salla-products-list
      data-testid="store-products-list"
      class="zod-products-list"
      source="{{ listing_source }}"
      sort-by="{{ initial_sort }}"
      {% if listing_value %}source-value="{{ listing_value }}"{% endif %}
      {{ has_filters ? 'filters-results' : '' }}
      product-card-component="custom-salla-product-card">
    </salla-products-list>
    <div class="zod-catalog-recovery" data-zod-catalog-recovery hidden role="alert" aria-live="polite">
      <i class="sicon-refresh" aria-hidden="true"></i>
      <div>
        <strong>{{ trans('zod.catalog.load_error') }}</strong>
        <p>{{ trans('zod.catalog.load_error_text') }}</p>
      </div>
      <button type="button" data-zod-catalog-retry>{{ trans('zod.catalog.retry') }}</button>
    </div>
    {% hook 'product:index.items.end' %}
  </div>
</div></section>
<div class="s-blocks-wrapper">{% hook 'product.index.after_products_group_with_filter' %}</div>
{% if store.settings.category.testimonial_enabled %}{% component 'home.testimonials' %}{% endif %}
<div class="s-blocks-wrapper">{% hook 'product.index.after_testimonials' %}</div>
{% endblock %}
{% block scripts %}<script defer src="{{ 'products.js'|asset }}"></script>{% endblock %}
